prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: @MMS_PC_NAME@
Description: @MMS_PC_DESCRIPTION@
Version: @MMS_PC_VERSION@
Requires: @MMS_PC_REQUIRES@
Cflags: -I${includedir}
Libs: -L${libdir} -l@MMS_PC_LIBNAME@
