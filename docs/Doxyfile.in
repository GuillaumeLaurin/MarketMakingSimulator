# Doxygen configuration template for MMS.
# Configured by cmake/Modules/MmsDocs.cmake into ${PROJECT_BINARY_DIR}/Doxyfile.
# Only the options that deviate from the Doxygen defaults are listed.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@
CREATE_SUBDIRS         = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = @PROJECT_SOURCE_DIR@
STRIP_FROM_INC_PATH    = @DOXYGEN_STRIP_INC@
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
USE_MDFILE_AS_MAINPAGE = @PROJECT_SOURCE_DIR@/docs/index.md

#---------------------------------------------------------------------------
# Build
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = NO
MAX_INITIALIZER_LINES  = 25

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = @DOXYGEN_INPUT@
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.hxx *.h *.cpp *.cxx *.md
EXCLUDE_PATTERNS       = */build/* */tests/* */bench/* */gen/* */_deps/* */vcpkg_installed/*
EXCLUDE_SYMBOLS        =
EXAMPLE_PATH           =
IMAGE_PATH             = @PROJECT_SOURCE_DIR@/docs

#---------------------------------------------------------------------------
# Diagnostics
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
# Flip to FAIL_ON_WARNINGS once the public API is fully documented.
WARN_AS_ERROR          = NO

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
GENERATE_LATEX         = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Diagrams (only used when Graphviz "dot" is available)
#---------------------------------------------------------------------------
HAVE_DOT               = @DOXYGEN_HAVE_DOT@
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
DOT_GRAPH_MAX_NODES    = 60

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = @DOXYGEN_PREDEFINED@
